# Always show the latest website (no stale HTML cache)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# Hide Git and repo files from visitors
RedirectMatch 404 /\.git
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
